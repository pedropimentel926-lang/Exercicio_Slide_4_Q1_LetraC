#include <stdio.h>
#include <locale.h>
int main(){
	setlocale(LC_ALL, "Portuguese");
	
	float valor;
	float imposto;
	float precoFinal;
	
	printf("Digite o valor do produto:\n");
	scanf("%f", &valor);
	
	imposto = valor * 0.08;
	precoFinal = imposto + valor;
	
	printf("O valor do imposto é %.2f\n", imposto);
	printf("O valor final é %.2f\n", precoFinal);
	
	
	
	 return 0; 
}	 
